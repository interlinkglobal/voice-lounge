# Server-only YouTube Data API configuration
YOUTUBE_DATA_API_KEY=
CHANNEL_ID=

# Google OAuth / secure cookie session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to the current origin + /auth/google/callback.
# Set this when Google Cloud has one fixed authorized redirect URI.
GOOGLE_REDIRECT_URI=
# 32+ random characters; used only server-side to encrypt/sign the session cookie.
SESSION_SECRET=
